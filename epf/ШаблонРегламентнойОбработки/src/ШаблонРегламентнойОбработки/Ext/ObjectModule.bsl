#Область ОписаниеПеременных

Перем ВходныеДанные;
Перем ВыходныеДанные;
Перем ЕстьОшибки;

#КонецОбласти

#Область ОписаниеОбработки

// Описание обработки для подсистемы БСП «Дополнительные отчёты и обработки».
// Вызывается платформой при загрузке файла обработки в справочник ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  Структура - параметры регистрации, см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт

	Результат = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.0.0.0");

	Результат.Вид             = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	Результат.Версия          = "21.09.26";
	Результат.Наименование    = "Шаблон регламентной обработки";
	Результат.Информация      = "21.09.2026 Каркас регламентной обработки: список команд, диспетчер выполнения,
	|логирование на форме";
	Результат.БезопасныйРежим = Истина;

	ДобавитьКоманды(Результат);

	Возврат Результат;

КонецФункции

// Список команд обработки. По нему строятся и карточка БСП, и кнопки на форме,
// поэтому новая команда добавляется только здесь — правки формы не нужны.
// Идентификатор команды обязан совпадать с именем процедуры в области ПрограммныйИнтерфейс:
// диспетчер ВыполнитьАлгоритмКоманды вызывает её по имени.
//
// Возвращаемое значение:
//  Массив из Структура - Идентификатор (Строка), Представление (Строка), Группа (Строка, имя группы на форме:
//                        «Основные», «Административные», «Отладка»)
//
Функция ПолучитьСписокКоманд() Экспорт

	Результат = Новый Массив;

	Результат.Добавить(Новый Структура("Идентификатор, Представление, Группа",
		"ВыполнитьРегламент", "(1) Выполнить регламент", "Основные"));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Команда-образец. Процедуры этой области вызываются диспетчером по имени, поэтому сигнатура фиксированная:
// один необязательный параметр. Результат складывается в ВыходныеДанные.Успешные / ВыходныеДанные.Ошибки —
// напрямую или через Сообщить с путём к данным «Ошибки» (см. ОбработатьСообщенияПользователю).
//
// Параметры:
//  ПараметрыВыполнения - Структура - параметры, переданные БСП, см. ВыполнитьКоманду
//                      - Неопределено - команда запущена без параметров
//
// Побочные эффекты:
//  Заполняет ВыходныеДанные.Успешные и ВыходныеДанные.Ошибки.
//
Процедура ВыполнитьРегламент(ПараметрыВыполнения = Неопределено) Экспорт

	ВыходныеДанные.Успешные.Добавить(СтрШаблон("Настроек прочитано: %1", ВходныеДанные.Настройки.Количество()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Готовит ВходныеДанные и ВыходныеДанные перед выполнением команды.
// Настройки берутся из справочника ДополнительныеОтчетыИОбработки — их пишет СохранитьНастройки
// (форма настроек обработки либо администратор), поэтому обработка не хранит их в себе.
//
// Параметры:
//  ПараметрыВыполнения - Структура - параметры, переданные БСП, см. ВыполнитьКоманду
//                      - Неопределено - вызов без параметров
//  ИзФормы             - Булево - вызвано из формы обработки, а не регламентным заданием
//
// Побочные эффекты:
//  Переустанавливает модульные переменные ВходныеДанные, ВыходныеДанные, ЕстьОшибки.
//
Процедура ИнициализацияДанных(ПараметрыВыполнения = Неопределено, ИзФормы = Ложь) Экспорт

	ЕстьОшибки = Ложь;

	ВыходныеДанные = Новый Структура("Стек, Ошибки, Успешные, ИзФормы", Новый Массив, Новый Массив, Новый Массив, ИзФормы);

	ОбработкаСсылка  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполнения, "ДополнительнаяОбработкаСсылка",
		Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка());
	ОбъектНазначения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполнения, "ОбъектНазначения", Неопределено);

	Настройки = ?(ЗначениеЗаполнено(ОбработкаСсылка),
		ДополнительныеОтчетыИОбработки.ЗагрузитьНастройки(ОбработкаСсылка), Неопределено);
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда Настройки = Новый Структура КонецЕсли;

	ВходныеДанные = Новый Структура("ОбработкаСсылка, ОбъектНазначения, Настройки",
		ОбработкаСсылка, ОбъектНазначения, Настройки);

КонецПроцедуры

// Точка входа БСП. Вызывается и регламентным заданием (через ВыполнитьОбработкуПоРегламентномуЗаданию),
// и кнопкой в карточке обработки, и формой обработки — код выполнения один на все сценарии.
//
// Параметры:
//  ИмяКоманды          - Строка - идентификатор команды, он же имя процедуры в области ПрограммныйИнтерфейс
//  ПараметрыВыполнения - Структура - параметры от БСП: ДополнительнаяОбработкаСсылка
//                        (СправочникСсылка.ДополнительныеОтчетыИОбработки), РезультатВыполнения (Структура),
//                        ОбъектыНазначения (Массив) — для назначаемых видов обработки
//                      - Неопределено - БСП вызывает так, если в СведенияОВнешнейОбработке не задана ВерсияБСП
//                        либо она младше 1.2.1.4
//
// Побочные эффекты:
//  Заполняет ПараметрыВыполнения.РезультатВыполнения.Ответ.
//
Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения = Неопределено) Экспорт

	Если ТипЗнч(ПараметрыВыполнения) <> Тип("Структура") Тогда ПараметрыВыполнения = Новый Структура КонецЕсли;
	РезультатВыполнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполнения, "РезультатВыполнения");
	Если ТипЗнч(РезультатВыполнения) <> Тип("Структура") Тогда ПараметрыВыполнения.Вставить("РезультатВыполнения", Новый Структура) КонецЕсли;

	ПараметрыВыполнения.РезультатВыполнения.Вставить("Ответ", Новый Массив);

	ОбъектыНазначения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыполнения, "ОбъектыНазначения");

	Если ТипЗнч(ОбъектыНазначения) = Тип("Массив") И ОбъектыНазначения.Количество() > 0 Тогда

		Для Каждого ОбъектНазначения Из ОбъектыНазначения Цикл
			ПараметрыВыполнения.Вставить("ОбъектНазначения", ОбъектНазначения);
			ВыполнитьАлгоритмКоманды(ИмяКоманды, ПараметрыВыполнения);
		КонецЦикла;

	Иначе

		ВыполнитьАлгоритмКоманды(ИмяКоманды, ПараметрыВыполнения);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет одну команду: инициализирует данные, вызывает процедуру по имени, собирает результат.
//
// Параметры:
//  ИмяКоманды          - Строка - идентификатор команды, он же имя процедуры в области ПрограммныйИнтерфейс
//  ПараметрыВыполнения - Структура - параметры от БСП, см. ВыполнитьКоманду
//
Процедура ВыполнитьАлгоритмКоманды(ИмяКоманды, ПараметрыВыполнения)

	ИнициализацияДанных(ПараметрыВыполнения);

	Если Не ЕстьОшибки Тогда
		Попытка
			Выполнить(СтрШаблон("%1(ПараметрыВыполнения)", ИмяКоманды));
		Исключение
			ЗафиксироватьОшибку(СтрШаблон("Ошибка выполнения команды ""%1"": %2", ИмяКоманды,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;

	ОбработатьСообщенияПользователю();

	ПараметрыВыполнения.РезультатВыполнения.Ответ.Добавить(Новый Структура("Команда, Успешные, Ошибки",
		ИмяКоманды, ВыходныеДанные.Успешные, ВыходныеДанные.Ошибки));

КонецПроцедуры

// Перекладывает накопленные платформой сообщения пользователю в ВыходныеДанные.
// Сообщение с путём к данным «Ошибки» попадает в Ошибки, остальные — в Успешные.
//
Процедура ОбработатьСообщенияПользователю()

	Для Каждого ДанныеСообщения Из ПолучитьСообщенияПользователю(Истина) Цикл
		Если ДанныеСообщения.ПутьКДанным = "Ошибки" Тогда
			ВыходныеДанные.Ошибки.Добавить(ДанныеСообщения.Текст);
		Иначе
			ВыходныеДанные.Успешные.Добавить(ДанныеСообщения.Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заполняет таблицу команд карточки БСП: команда открытия формы плюс по команде на каждую строку
// ПолучитьСписокКоманд. Расписание здесь не задаётся — его настраивает администратор в карточке
// обработки, состав колонок таблицы команд расписания не предусматривает.
//
// Параметры:
//  ПараметрыРегистрации - Структура - см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Процедура ДобавитьКоманды(ПараметрыРегистрации)

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление      = "Форма";
	НоваяКоманда.Идентификатор      = СтрШаблон("%1_Форма", Метаданные().Имя);
	НоваяКоманда.Использование      = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Истина;

	Для Каждого СтрКоманды Из ПолучитьСписокКоманд() Цикл
		НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, СтрКоманды);
		НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
		НоваяКоманда.ПоказыватьОповещение = Истина;
	КонецЦикла;

КонецПроцедуры

// Фиксирует ошибку в ВыходныеДанные.Ошибки и взводит признак ЕстьОшибки.
//
// Параметры:
//  ТекстСообщения - Строка - текст ошибки
//  ДанныеОтвета   - Произвольный - данные, которые дописываются к тексту в виде JSON
//                 - Неопределено - без дополнительных данных
//
Процедура ЗафиксироватьОшибку(ТекстСообщения, ДанныеОтвета = Неопределено)

	ЕстьОшибки = Истина;

	ВыходныеДанные.Ошибки.Добавить(СтрШаблон("%1%2%3", ТекстСообщения, ?(ДанныеОтвета = Неопределено, "", ":" + Символы.ПС),
		?(ДанныеОтвета = Неопределено, "", ОбщегоНазначения.ЗначениеВJSON(ДанныеОтвета))));

КонецПроцедуры

#КонецОбласти
