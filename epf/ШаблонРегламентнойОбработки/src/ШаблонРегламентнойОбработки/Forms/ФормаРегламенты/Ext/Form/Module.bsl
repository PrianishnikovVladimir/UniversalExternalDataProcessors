#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Модуль = РеквизитФормыВЗначение("Объект");

	Для Каждого СтрКоманды Из Модуль.ПолучитьСписокКоманд() Цикл

		ИмяГруппы = ?(ЗначениеЗаполнено(СтрКоманды.Группа), СтрКоманды.Группа, "Основные");
		Родитель  = Элементы.Найти(ИмяГруппы);
		Если Родитель = Неопределено Тогда Родитель = Элементы.ГруппаКнопокРегламенты КонецЕсли;

		НоваяКоманда = Команды.Добавить(СтрКоманды.Идентификатор);
		НоваяКоманда.Заголовок = СтрКоманды.Представление;
		НоваяКоманда.Действие  = "ВыполнениеКоманды";

		НовыйЭлемент = Элементы.Добавить(СтрКоманды.Идентификатор, Тип("КнопкаФормы"), Родитель);
		НовыйЭлемент.Заголовок = СтрКоманды.Представление;
		НовыйЭлемент.ИмяКоманды = СтрКоманды.Идентификатор;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнениеКоманды(Команда)

	УстановитьНаименованиеВыполняемогоМетода(Команда.Имя);

	ЗаполнитьЛогирование(СтрШаблон("Регламент: %1", Команда.Имя),, Истина);

	ПараметрыКоманды = Новый Структура("ДополнительнаяОбработкаСсылка", ОбъектСсылка);

	Если Объект.ВФоне Тогда
		ДополнительныеОтчетыИОбработкиКлиент.ВыполнитьКомандуВФоне(Команда.Имя, ПараметрыКоманды, ЭтаФорма);
		Возврат;
	КонецЕсли;

	ВыполнениеКомандыНаСервере(Команда.Имя, ПараметрыКоманды);

	Если ТипЗнч(ПараметрыКоманды) = Тип("Структура") И ПараметрыКоманды.Свойство("РезультатВыполнения")
		И ПараметрыКоманды.РезультатВыполнения.Свойство("Ответ") Тогда

		ЭтоПервый = Истина;

		Для Каждого СтрОтвета Из ПараметрыКоманды.РезультатВыполнения.Ответ Цикл
			Если ЭтоПервый Тогда ЭтоПервый = Ложь Иначе ЗаполнитьЛогирование(,,,, Истина) КонецЕсли;
			ЗаполнитьЛогирование(, СтрОтвета);
		КонецЦикла;

	КонецЕсли;

	ЗаполнитьЛогирование(СтрШаблон("Регламент: %1", Команда.Имя),,, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьЛогирование(Команда)

	Если ПустаяСтрока(Логирование.ПолучитьТекст()) Тогда
		ПоказатьПредупреждение("Логирование пустое. Сохранение невозможно",, 30, "Ошибка сохранения");
		Возврат;
	КонецЕсли;

	ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохраненияФайла.ПолноеИмяФайла   = ВыполняемыйМетод;
	ДиалогСохраненияФайла.Фильтр           = "Текст(*.txt)|*.txt";
	ДиалогСохраненияФайла.МножественныйВыбор = Ложь;
	ДиалогСохраненияФайла.Заголовок        = "Сохранение";

	Если ДиалогСохраненияФайла.Выбрать() Тогда
		Логирование.Записать(ДиалогСохраненияФайла.ПолноеИмяФайла);
		ПоказатьОповещениеПользователя("Файл сохранен", Новый ОписаниеОповещения("ОткрытьФайл", ЭтаФорма, ДиалогСохраненияФайла.ПолноеИмяФайла),
			ДиалогСохраненияФайла.ПолноеИмяФайла);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запускает команду обработки через БСП и возвращает результат в ПараметрыКоманды.РезультатВыполнения.
//
// Параметры:
//  ИдентификаторКоманды - Строка - идентификатор команды из ПолучитьСписокКоманд
//  ПараметрыКоманды     - Структура - параметры команды; БСП дописывает в неё РезультатВыполнения
//
&НаСервере
Процедура ВыполнениеКомандыНаСервере(ИдентификаторКоманды, ПараметрыКоманды)

	ДополнительныеОтчетыИОбработки.ВыполнитьКомандуИзФормыВнешнегоОбъекта(ИдентификаторКоманды, ПараметрыКоманды, ЭтаФорма);

КонецПроцедуры

// Формирует заголовок для имени файла лога: имя команды и выбранный период.
//
// Параметры:
//  Наименование - Строка - имя выполняемой команды
//
&НаКлиенте
Процедура УстановитьНаименованиеВыполняемогоМетода(Наименование)

	ВыполняемыйМетод = СтрШаблон("%1%2%3", Наименование,
		?(ЗначениеЗаполнено(Период.ДатаНачала), СтрШаблон(" от %1", Формат(Период.ДатаНачала, "ДЛФ=D")), ""),
		?(ЗначениеЗаполнено(Период.ДатаОкончания), СтрШаблон(" по %1", Формат(Период.ДатаОкончания, "ДЛФ=D")), ""));

КонецПроцедуры

// Пишет в поле логирования формы. Режим задаётся одним из флагов; без флагов выводится содержимое
// ДополнительныеПараметры — блоки «Успешные» и «Ошибки».
//
// Параметры:
//  ЗаголовокЛогирования  - Строка - текст для строк старта и окончания
//  ДополнительныеПараметры - Структура - строка ответа с полями Успешные (Массив) и Ошибки (Массив)
//                          - Неопределено - выводить нечего
//  ЭтоНачало             - Булево - очистить лог и написать строку старта
//  ЭтоКонец              - Булево - написать строку окончания
//  ЭтоПереход            - Булево - написать разделитель между ответами
//
&НаСервере
Процедура ЗаполнитьЛогирование(ЗаголовокЛогирования = "", ДополнительныеПараметры = Неопределено, ЭтоНачало = Ложь, ЭтоКонец = Ложь, ЭтоПереход = Ложь)

	Если ЭтоНачало Тогда
		Логирование.Очистить();
		Логирование.ДобавитьСтроку(СтрШаблон("Старт %1: %2", ЗаголовокЛогирования, Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT")));
		Возврат;
	КонецЕсли;

	Если ЭтоКонец Тогда
		Логирование.ДобавитьСтроку(СтрШаблон("Окончание %1: %2", ЗаголовокЛогирования, Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT")));
		Возврат;
	КонецЕсли;

	Если ЭтоПереход Тогда Логирование.ДобавитьСтроку("------------------------------------------------------------"); Возврат КонецЕсли;

	Если ДополнительныеПараметры = Неопределено Тогда Возврат КонецЕсли;

	Если ДополнительныеПараметры.Успешные.Количество() > 0 Тогда
		Логирование.ДобавитьСтроку("Успешные:");
		Для Каждого СтрокаСообщения Из ДополнительныеПараметры.Успешные Цикл Логирование.ДобавитьСтроку(СтрокаСообщения) КонецЦикла;
	КонецЕсли;

	Если ДополнительныеПараметры.Ошибки.Количество() > 0 Тогда
		Логирование.ДобавитьСтроку("Ошибки:");
		Для Каждого СтрокаСообщения Из ДополнительныеПараметры.Ошибки Цикл Логирование.ДобавитьСтроку(СтрокаСообщения) КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Открывает сохранённый файл лога.
//
// Параметры:
//  ПутьКФайлу - Строка - полное имя сохранённого файла
//
&НаКлиенте
Процедура ОткрытьФайл(ПутьКФайлу) Экспорт

	ЗапуститьПриложение(ПутьКФайлу);

КонецПроцедуры

#КонецОбласти
