#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// БСП открывает форму с параметром ДополнительнаяОбработкаСсылка. Если обработка открыта файлом, ссылки нет,
	// и фоновый запуск недоступен: в фоне команду выполняет ДополнительныеОтчетыИОбработки.ВыполнитьКоманду по ссылке на карточку.
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда ОбъектСсылка = Параметры.ДополнительнаяОбработкаСсылка КонецЕсли;

	Объект.ВФоне       = ЗначениеЗаполнено(ОбъектСсылка);
	ОтображатьПрогресс = Истина;

	Модуль = РеквизитФормыВЗначение("Объект");

	Для Каждого СтрКоманды Из Модуль.ПолучитьСписокКоманд() Цикл

		ИмяГруппы = ?(ЗначениеЗаполнено(СтрКоманды.Группа), СтрКоманды.Группа, "Основные");
		Родитель  = Элементы.Найти(ИмяГруппы);
		Если Родитель = Неопределено Тогда Родитель = Элементы.ГруппаКнопокРегламенты КонецЕсли;

		НоваяКоманда = Команды.Добавить(СтрКоманды.Идентификатор);
		НоваяКоманда.Заголовок = СтрКоманды.Представление;
		НоваяКоманда.Действие  = "ВыполнениеКоманды";

		НовыйЭлемент = Элементы.Добавить(СтрКоманды.Идентификатор, Тип("КнопкаФормы"), Родитель);
		НовыйЭлемент.Заголовок = СтрКоманды.Представление;
		НовыйЭлемент.ИмяКоманды = СтрКоманды.Идентификатор;

	КонецЦикла;

	УправлениеДоступностью(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВФонеПриИзменении(Элемент)

	УправлениеДоступностью(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОтображатьПрогрессПриИзменении(Элемент)

	УправлениеДоступностью(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнениеКоманды(Команда)

	Если ЗначениеЗаполнено(ВыполняемаяКоманда) Тогда
		ПоказатьПредупреждение(, СтрШаблон("Уже выполняется команда «%1». Дождитесь завершения или отмените её.", ВыполняемаяКоманда));
		Возврат;
	КонецЕсли;

	ВыполняемаяКоманда = Команда.Заголовок;
	НачалоВыполнения   = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПроцентВыполнения  = 0;
	ТекстПрогресса     = "";
	СостояниеЗадания   = СтрШаблон("Выполняется: %1", ВыполняемаяКоманда);

	УстановитьНаименованиеВыполняемогоМетода(Команда.Имя);

	Если Объект.ВФоне Тогда
		ЗапуститьКомандуВФоне(Команда.Имя);
	Иначе
		ЗавершитьВыполнение(ВыполнитьКомандуНаСервере(Команда.Имя), Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьЗадание(Команда)

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда Возврат КонецЕсли;

	ОтменитьФоновоеЗадание(ИдентификаторЗадания);
	СостояниеЗадания = СтрШаблон("Отмена: %1", ВыполняемаяКоманда);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьЛогирование(Команда)

	Если ПустаяСтрока(Логирование.ПолучитьТекст()) Тогда
		ПоказатьПредупреждение("Логирование пустое. Сохранение невозможно",, 30, "Ошибка сохранения");
		Возврат;
	КонецЕсли;

	ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохраненияФайла.ПолноеИмяФайла   = ВыполняемыйМетод;
	ДиалогСохраненияФайла.Фильтр           = "Текст(*.txt)|*.txt";
	ДиалогСохраненияФайла.МножественныйВыбор = Ложь;
	ДиалогСохраненияФайла.Заголовок        = "Сохранение";

	Если ДиалогСохраненияФайла.Выбрать() Тогда
		Логирование.Записать(ДиалогСохраненияФайла.ПолноеИмяФайла);
		ПоказатьОповещениеПользователя("Файл сохранен", Новый ОписаниеОповещения("ОткрытьФайл", ЭтаФорма, ДиалогСохраненияФайла.ПолноеИмяФайла),
			ДиалогСохраненияФайла.ПолноеИмяФайла);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФоновоеВыполнение

// Запускает команду фоновым заданием и подключает ожидание: статус и прогресс выводятся на форму,
// окно ожидания БСП не открывается - форма остаётся доступной.
//
// Параметры:
//  ИмяКоманды - Строка - идентификатор команды из ПолучитьСписокКоманд
//
&НаКлиенте
Процедура ЗапуститьКомандуВФоне(ИмяКоманды)

	ДлительнаяОперация   = НачатьВыполнениеКомандыВФоне(ИмяКоманды);
	ИдентификаторЗадания = ?(ЗначениеЗаполнено(ДлительнаяОперация.ИдентификаторЗадания), ДлительнаяОперация.ИдентификаторЗадания,
		ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());

	УправлениеДоступностью(ЭтаФорма);

	// Прогресс принимаем всегда: тумблер «Отображать прогресс» управляет только видимостью, и его можно
	// переключать, пока задание идёт. Обработчик прогресса БСП вызывает лишь при ВыводитьОкноОжидания = Ложь.
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтаФорма);
	ПараметрыОжидания.ВыводитьОкноОжидания           = Ложь;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПриОбновленииПрогресса", ЭтаФорма);

	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Новый ОписаниеОповещения("ПриЗавершенииФоновойКоманды", ЭтаФорма, ИмяКоманды),
		ПараметрыОжидания);

КонецПроцедуры

// Начинает лог и запускает ДополнительныеОтчетыИОбработки.ВыполнитьКоманду в фоновом задании - тот же путь,
// которым БСП выполняет команду по расписанию, поэтому обработка ведёт себя в фоне так же, как в регламентном задании.
//
// Параметры:
//  ИмяКоманды - Строка - идентификатор команды из ПолучитьСписокКоманд
//
// Возвращаемое значение:
//  Структура - см. ДлительныеОперации.ВыполнитьФункцию
//
&НаСервере
Функция НачатьВыполнениеКомандыВФоне(Знач ИмяКоманды)

	ЗаполнитьЛогирование(СтрШаблон("Регламент: %1", ИмяКоманды),, Истина);

	ПараметрыКоманды = Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды", ОбъектСсылка, ИмяКоманды);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = СтрШаблон("%1: %2", ОбъектСсылка, ВыполняемаяКоманда);

	Результат = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "ДополнительныеОтчетыИОбработки.ВыполнитьКоманду", ПараметрыКоманды);

	Возврат Результат;

КонецФункции

// Обработчик оповещения о прогрессе фонового задания.
//
// Параметры:
//  Состояние               - Структура - см. ДлительныеОперацииКлиент.НовоеСостояниеДлительнойОперации
//  ДополнительныеПараметры - Неопределено - не используется
//
&НаКлиенте
Процедура ПриОбновленииПрогресса(Состояние, ДополнительныеПараметры) Экспорт

	Если Состояние.Статус <> "Выполняется" Или Состояние.Прогресс = Неопределено Тогда Возврат КонецЕсли;

	Если Состояние.Прогресс.Свойство("Процент") Тогда ПроцентВыполнения = Состояние.Прогресс.Процент КонецЕсли;
	Если Состояние.Прогресс.Свойство("Текст") Тогда ТекстПрогресса = Состояние.Прогресс.Текст КонецЕсли;

КонецПроцедуры

// Обработчик завершения фонового задания.
//
// Параметры:
//  РезультатЗадания - Структура - см. ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации
//                   - Неопределено - задание отменено
//  ИмяКоманды       - Строка - идентификатор выполненной команды
//
&НаКлиенте
Процедура ПриЗавершенииФоновойКоманды(РезультатЗадания, ИмяКоманды) Экспорт

	ЗавершитьВыполнение(ОбработатьРезультатФоновогоЗадания(РезультатЗадания, ИмяКоманды), Истина);

КонецПроцедуры

// Выводит результат фонового задания в лог формы.
//
// Параметры:
//  РезультатЗадания - Структура - см. ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации
//                   - Неопределено - задание отменено
//  ИмяКоманды       - Строка - идентификатор выполненной команды
//
// Возвращаемое значение:
//  Строка - статус для строки состояния: «Выполнено», «Выполнено с ошибками», «Ошибка» или «Отменено»
//
&НаСервере
Функция ОбработатьРезультатФоновогоЗадания(Знач РезультатЗадания, Знач ИмяКоманды)

	Результат = "Отменено";

	Если РезультатЗадания = Неопределено Тогда

		Логирование.ДобавитьСтроку("Задание отменено.");

	ИначеЕсли РезультатЗадания.Статус = "Ошибка" Тогда

		Результат = "Ошибка";
		Логирование.ДобавитьСтроку("Ошибка фонового задания:");
		Логирование.ДобавитьСтроку(?(РезультатЗадания.ИнформацияОбОшибке = Неопределено, РезультатЗадания.ПодробноеПредставлениеОшибки,
			ПодробноеПредставлениеОшибки(РезультатЗадания.ИнформацияОбОшибке)));

	Иначе

		Результат = ВывестиОтветВЛог(ПолучитьИзВременногоХранилища(РезультатЗадания.АдресРезультата));

	КонецЕсли;

	Если РезультатЗадания <> Неопределено И ЗначениеЗаполнено(РезультатЗадания.Сообщения) Тогда
		Логирование.ДобавитьСтроку("Сообщения задания:");
		Для Каждого Сообщение Из РезультатЗадания.Сообщения Цикл Логирование.ДобавитьСтроку(Сообщение.Текст) КонецЦикла;
	КонецЕсли;

	ЗаполнитьЛогирование(СтрШаблон("Регламент: %1", ИмяКоманды),,, Истина);

	Возврат Результат;

КонецФункции

// Отменяет фоновое задание. Обработчик завершения после этого получит Неопределено.
//
// Параметры:
//  Идентификатор - УникальныйИдентификатор - идентификатор фонового задания
//
&НаСервереБезКонтекста
Процедура ОтменитьФоновоеЗадание(Знач Идентификатор)

	ДлительныеОперации.ОтменитьВыполнениеЗадания(Идентификатор);

КонецПроцедуры

#КонецОбласти

// Выполняет команду в текущем сеансе, без фонового задания, и выводит результат в лог.
//
// Параметры:
//  ИмяКоманды - Строка - идентификатор команды из ПолучитьСписокКоманд
//
// Возвращаемое значение:
//  Строка - статус для строки состояния: «Выполнено», «Выполнено с ошибками» или «Ошибка»
//
&НаСервере
Функция ВыполнитьКомандуНаСервере(Знач ИмяКоманды)

	Результат = "Ошибка";

	ЗаполнитьЛогирование(СтрШаблон("Регламент: %1", ИмяКоманды),, Истина);

	ПараметрыКоманды = Новый Структура("ДополнительнаяОбработкаСсылка", ОбъектСсылка);

	Попытка
		Результат = ВывестиОтветВЛог(ДополнительныеОтчетыИОбработки.ВыполнитьКомандуИзФормыВнешнегоОбъекта(ИмяКоманды, ПараметрыКоманды, ЭтаФорма));
	Исключение
		Логирование.ДобавитьСтроку("Ошибка:");
		Логирование.ДобавитьСтроку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаполнитьЛогирование(СтрШаблон("Регламент: %1", ИмяКоманды),,, Истина);

	Возврат Результат;

КонецФункции

// Выводит в лог ответы команды - по блоку на каждый вызов процедуры команды.
//
// Параметры:
//  РезультатВыполнения - Структура - результат ДополнительныеОтчетыИОбработки.ВыполнитьКоманду, ключ Ответ -
//                        Массив из Структура с полями Команда (Строка), Успешные (Массив), Ошибки (Массив)
//                      - Неопределено - команда ничего не вернула
//
// Возвращаемое значение:
//  Строка - «Выполнено с ошибками», если хоть в одном ответе есть ошибки, иначе «Выполнено»
//
&НаСервере
Функция ВывестиОтветВЛог(РезультатВыполнения)

	Результат = "Выполнено";

	Ответ = Неопределено;
	Если ТипЗнч(РезультатВыполнения) = Тип("Структура") Тогда РезультатВыполнения.Свойство("Ответ", Ответ) КонецЕсли;
	Если ТипЗнч(Ответ) <> Тип("Массив") Тогда Ответ = Новый Массив КонецЕсли;

	Для Индекс = 0 По Ответ.ВГраница() Цикл
		Если Индекс > 0 Тогда ЗаполнитьЛогирование(,,,, Истина) КонецЕсли;
		ЗаполнитьЛогирование(, Ответ[Индекс]);
		Если Ответ[Индекс].Ошибки.Количество() > 0 Тогда Результат = "Выполнено с ошибками" КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Фиксирует окончание команды: строка состояния, сброс признака выполнения, оповещение пользователя.
//
// Параметры:
//  Статус             - Строка - «Выполнено», «Выполнено с ошибками», «Ошибка» или «Отменено»
//  ПоказатьОповещение - Булево - показать всплывающее оповещение: пользователь мог уйти с формы, пока шло фоновое задание
//
&НаКлиенте
Процедура ЗавершитьВыполнение(Статус, ПоказатьОповещение)

	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения) / 1000;

	СостояниеЗадания = СтрШаблон("%1: %2 - %3 с", Статус, ВыполняемаяКоманда, Формат(Длительность, "ЧДЦ=1; ЧН=0"));
	Если Статус = "Выполнено" Тогда ПроцентВыполнения = 100 КонецЕсли;

	Если ПоказатьОповещение Тогда ПоказатьОповещениеПользователя(Статус,, ВыполняемаяКоманда) КонецЕсли;

	ВыполняемаяКоманда   = "";
	ИдентификаторЗадания = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();

	УправлениеДоступностью(ЭтаФорма);

КонецПроцедуры

// Доступность и видимость элементов в зависимости от режима запуска и состояния задания.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - эта форма
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностью(Форма)

	ЭлементыФормы = Форма.Элементы;
	Выполняется   = ЗначениеЗаполнено(Форма.ВыполняемаяКоманда);
	ПоказатьХод   = Форма.Объект.ВФоне И Форма.ОтображатьПрогресс;

	ЭлементыФормы.ВФоне.Доступность              = ЗначениеЗаполнено(Форма.ОбъектСсылка) И Не Выполняется;
	ЭлементыФормы.ОтображатьПрогресс.Доступность = Форма.Объект.ВФоне;
	ЭлементыФормы.ГруппаСостояние.Видимость      = Выполняется Или ЗначениеЗаполнено(Форма.СостояниеЗадания);
	ЭлементыФормы.ИндикаторПрогресса.Видимость   = ПоказатьХод;
	ЭлементыФормы.ТекстПрогресса.Видимость       = ПоказатьХод;
	ЭлементыФормы.ОтменитьЗадание.Видимость      = Выполняется И ЗначениеЗаполнено(Форма.ИдентификаторЗадания);

КонецПроцедуры

// Формирует заголовок для имени файла лога: имя команды и выбранный период.
//
// Параметры:
//  Наименование - Строка - имя выполняемой команды
//
&НаКлиенте
Процедура УстановитьНаименованиеВыполняемогоМетода(Наименование)

	ВыполняемыйМетод = СтрШаблон("%1%2%3", Наименование,
		?(ЗначениеЗаполнено(Период.ДатаНачала), СтрШаблон(" от %1", Формат(Период.ДатаНачала, "ДЛФ=D")), ""),
		?(ЗначениеЗаполнено(Период.ДатаОкончания), СтрШаблон(" по %1", Формат(Период.ДатаОкончания, "ДЛФ=D")), ""));

КонецПроцедуры

// Пишет в поле логирования формы. Режим задаётся одним из флагов; без флагов выводится содержимое
// ДополнительныеПараметры - блоки «Успешные» и «Ошибки».
//
// Параметры:
//  ЗаголовокЛогирования    - Строка - текст для строк старта и окончания
//  ДополнительныеПараметры - Структура - строка ответа с полями Успешные (Массив) и Ошибки (Массив)
//                          - Неопределено - выводить нечего
//  ЭтоНачало               - Булево - очистить лог и написать строку старта
//  ЭтоКонец                - Булево - написать строку окончания
//  ЭтоПереход              - Булево - написать разделитель между ответами
//
&НаСервере
Процедура ЗаполнитьЛогирование(ЗаголовокЛогирования = "", ДополнительныеПараметры = Неопределено, ЭтоНачало = Ложь, ЭтоКонец = Ложь, ЭтоПереход = Ложь)

	Если ЭтоНачало Тогда
		Логирование.Очистить();
		Логирование.ДобавитьСтроку(СтрШаблон("Старт %1: %2", ЗаголовокЛогирования, Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT")));
		Возврат;
	КонецЕсли;

	Если ЭтоКонец Тогда
		Логирование.ДобавитьСтроку(СтрШаблон("Окончание %1: %2", ЗаголовокЛогирования, Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT")));
		Возврат;
	КонецЕсли;

	Если ЭтоПереход Тогда Логирование.ДобавитьСтроку("------------------------------------------------------------"); Возврат КонецЕсли;

	Если ДополнительныеПараметры = Неопределено Тогда Возврат КонецЕсли;

	Если ДополнительныеПараметры.Успешные.Количество() > 0 Тогда
		Логирование.ДобавитьСтроку("Успешные:");
		Для Каждого СтрокаСообщения Из ДополнительныеПараметры.Успешные Цикл Логирование.ДобавитьСтроку(СтрокаСообщения) КонецЦикла;
	КонецЕсли;

	Если ДополнительныеПараметры.Ошибки.Количество() > 0 Тогда
		Логирование.ДобавитьСтроку("Ошибки:");
		Для Каждого СтрокаСообщения Из ДополнительныеПараметры.Ошибки Цикл Логирование.ДобавитьСтроку(СтрокаСообщения) КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Открывает сохранённый файл лога.
//
// Параметры:
//  ПутьКФайлу - Строка - полное имя сохранённого файла
//
&НаКлиенте
Процедура ОткрытьФайл(ПутьКФайлу) Экспорт

	ЗапуститьПриложение(ПутьКФайлу);

КонецПроцедуры

#КонецОбласти
